---
import Parser from 'rss-parser';

const FEED_PROXY_URL = '/api/substack-feed';

const parser = new Parser({
  customFields: {
    item: ['media:content', 'content']
  }
});

let posts = [];

try {
  const response = await fetch(FEED_PROXY_URL);

  if (!response.ok) {
    throw new Error(`Substack feed request failed: ${response.status}`);
  }

  const xml = await response.text();
  const feed = await parser.parseString(xml);
  const items = Array.isArray(feed?.items) ? feed.items : [];

  posts = items.slice(0, 3).map((item) => {
    const content = item?.content || item?.contentSnippet || '';
    const imgRegex = /<img[^>]+src="([^"]+)"/i;
    const match = content.match(imgRegex);

    const coverImage =
      item?.enclosure?.url ||
      item?.image?.url ||
      item?.['media:content']?.$?.url ||
      (match ? match[1] : null);

    const summaryText = (item?.contentSnippet || item?.content || '')
      .toString()
      .replace(/<[^>]+>/g, '')
      .replace(/\s+/g, ' ')
      .trim();

    return {
      title: item?.title || 'Untitled post',
      link: item?.link || '#',
      pubDate: item?.pubDate
        ? new Date(item.pubDate).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          })
        : '',
      summary: summaryText || 'Read more on Substack.',
      coverImage
    };
  });
} catch (error) {
  console.error('Error fetching Substack feed:', error);
  posts = [];
}
---

<div class="substack-feed">
  {posts.length === 0 ? (
    <p>No recent posts found.</p>
  ) : (
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          {post.coverImage && (
            <div class="card-image">
              <img src={post.coverImage} alt={post.title} loading="lazy" />
            </div>
          )}
          <div class="card-content">
            <time datetime={post.pubDate}>{post.pubDate}</time>
            <h3>
              <a href={post.link} target="_blank" rel="noopener noreferrer">
                {post.title}
              </a>
            </h3>
            <p>{post.summary}</p>
            <a href={post.link} target="_blank" rel="noopener noreferrer" class="read-more">
              Read on Substack &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  )}
</div>

<style>
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1rem 0 0;
  }
  .post-card {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    width: 85%;
    max-width: 100%;
  }
  .card-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }
  time {
    font-size: 0.85rem;
    color: #64748b;
  }
  h3 a {
    color: #0f172a;
    text-decoration: none;
    font-weight: 700;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  p {
    color: #334155;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .read-more {
    margin-top: auto;
    padding-top: 1rem;
    color: #ff5400;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
