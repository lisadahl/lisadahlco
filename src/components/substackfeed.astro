---
import Parser from 'rss-parser';

const SUBSTACK_FEED_URL = 'https://dahllm.substack.com/feed';

const parser = new Parser();
let posts = [];

try {
  const feed = await parser.parseURL(SUBSTACK_FEED_URL);
  
  posts = feed.items.slice(0, 3).map(item => {
    // Extract the first image from the content if it exists
    const imgRegex = /<img[^>]+src="([^">]+)"/;
    const match = item.content?.match(imgRegex);
    const coverImage = match ? match[1] : null;

    return {
      title: item.title,
      link: item.link,
      pubDate: item.pubDate ? new Date(item.pubDate).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      }) : '',
      // Substack puts a clean text summary in contentSnippet
      summary: item.contentSnippet?.split('\n')[0] || '', 
      coverImage
    };
  });
} catch (error) {
  console.error('Error fetching Substack feed:', error);
}
---

                <div class="substack-feed">
                    {posts.length === 0 ? (
                        <p>No recent posts found.</p>
                    ) : (
                        <div class="posts-grid">
                        {posts.map(post => (
                            <article class="post-card">
                            {post.coverImage && (
                                <div class="card-image">
                                <img src={post.coverImage} alt={post.title} loading="lazy" />
                                </div>
                            )}
                            <div class="card-content">
                                <time datetime={post.pubDate}>{post.pubDate}</time>
                                <h3>
                                <a href={post.link} target="_blank" rel="noopener noreferrer">
                                    {post.title}
                                </a>
                                </h3>
                                <p>{post.summary}</p>
                                <a href={post.link} target="_blank" rel="noopener noreferrer" class="read-more">
                                Read on Substack &rarr;
                                </a>
                            </div>
                            </article>
                        ))}
                        </div>
                    )}
                    </div>

                    <style>
                    .posts-grid {
                        display: grid;
                        grid-template-columns: 1fr;
                        gap: 1.25rem;
                        margin: 1rem 0 0;
                    }
                    .post-card {
                        border: 1px solid #e2e8f0;
                        border-radius: 8px;
                        overflow: hidden;
                        display: flex;
                        flex-direction: column;
                        background: #ffffff;
                        width: 85%;
                        max-width: 100%;
                    }
                    .card-image img {
                        width: 100%;
                        height: 200px;
                        object-fit: cover;
                    }
                    .card-content {
                        padding: 1.5rem;
                        display: flex;
                        flex-direction: column;
                        gap: 0.5rem;
                        flex-grow: 1;
                    }
                    time {
                        font-size: 0.85rem;
                        color: #64748b;
                    }
                    h3 a {
                        color: #0f172a;
                        text-decoration: none;
                        font-weight: 700;
                    }
                    h3 a:hover {
                        text-decoration: underline;
                    }
                    p {
                        color: #334155;
                        font-size: 0.95rem;
                        line-height: 1.5;
                        display: -webkit-box;
                        -webkit-line-clamp: 3;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                    }
                    .read-more {
                        margin-top: auto;
                        padding-top: 1rem;
                        color: #ff5400; /* Substack Orange */
                        text-decoration: none;
                        font-weight: 600;
                        font-size: 0.9rem;
                    }
                    </style>