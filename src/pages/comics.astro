---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ComicPreview from '../components/ComicPreview.astro';
import {getCollection, getEntry } from 'astro:content';
import { getAllComicNames, getLatestPanel,formatDate } from '../api/utils';
import Meta from "../components/meta.astro";

const imageImports = import.meta.glob('../images/**/*.{png,jpg,jpeg,JPG,JPEG,gif,webp}',{
  eager: true
});

var ArrayOfTitles = await getAllComicNames("comics");
var ArrayOfFirstEntries=[];
for(var comics of ArrayOfTitles)
{
  var count = await getLatestPanel(comics);
  var firstEntry = await getEntry('comics',comics+"/1")
  var lastEntry = await getEntry('comics',comics+"/"+count);
    if(!firstEntry.data.ogImage){
      //console.error("Missing ogImage for: ", comics,firstEntry);
    }
    const rawPath = firstEntry.data.ogImage;
    const normalized = rawPath.replace(/\\/g, "/");
    const key = `${normalized}`;

    const imageModule = imageImports[key];

    if(!imageModule){
      //console.error("image not found in glob: ", key);
    }
    const imgUrl = (imageModule as {default: string }| undefined)?.default;
     ArrayOfFirstEntries.push({
      firstEntry,
      lastEntry,
      imgUrl
    });

}



---
<Meta/>
<body>

<Navigation/>

<ul class ="content_preview_grid">
 {
 ArrayOfFirstEntries.map(entry => {
    return (
            <ComicPreview 
              lastUpdated={formatDate(entry.firstEntry.data.date)}
              link={`/comics/${entry.firstEntry.slug.split("/")[0]}/1`} 
              title={entry.firstEntry.data.title} 
              imgTitle={entry.imgUrl} 
               
            />
    );
})}
  
</ul>


<Footer/>
</body>