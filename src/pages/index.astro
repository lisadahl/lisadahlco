---
const pageTitle = "lisadahl.co - Lisa Dahl's Portfolio";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Meta from "../components/meta.astro";
import SubstackFeed from "../components/SubstackFeed.astro";

---


<html lang="en">

    <Meta/>
    
    <Navigation/>
    <body>

        <div class="content_display_panel custom_override">
            <img src="/assets/Site_Title.png" alt="A drawing of Lisa's logo." class="page_image" width="75%" align="center"/><br /><br />
                    <iframe src="https://dahllm.substack.com/embed" width="80%" height="320" style="border: 1px solid #EEE; background: white"></iframe>
                <br /><br />
            <h2>Recent Updates</h2><br />
            <!--   <SubstackFeed />-->
            <div class="substack-post-embed"><p lang="en">New Traveldogues Book & New Website! by Lisa Dahl</p><p>What a mid-Fall Semester update!</p><a data-post-link href="https://dahllm.substack.com/p/new-traveldogues-book-and-new-website">Read on Substack</a></div><script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>
            <div class="substack-post-embed"><p lang="en">Diagnosing Banshee Debuts at SPX 2026!</p><p>And more notes on a very packed Fall 2026</p><a data-post-link href="https://dahllm.substack.com/p/diagnosing-banshee-debuts-at-spx">Read on Substack</a></div><script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>
            <div class="substack-post-embed"><p lang="en">CCA Comics Festival @ Sour Cherry, San Francisco</p><p>Tabling before the fireworks!</p><a data-post-link href="https://dahllm.substack.com/p/cca-comics-festival-sour-cherry-san">Read on Substack</a></div><script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>
            <div class="substack-post-embed custom_substack_override"><p lang="en">In Banshee's Memory: Diggy Diggy Hole Game</p><p></p><a data-post-link href="https://dahllm.substack.com/p/in-banshees-memory-diggy-diggy-hole">Read on Substack</a></div><script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script><br />
            <div class="substack-post-embed"><p lang="en">Joining the Camano Arts community</p><p>First exhibit with Camano Arts Association</p><a data-post-link href="https://dahllm.substack.com/p/joining-the-camano-arts-community">Read on Substack</a></div><script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>
            </div>
            <Footer/>
        </body>
</html>
