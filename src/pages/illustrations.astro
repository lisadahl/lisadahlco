---
import { getCollection } from 'astro:content';
import ComicPreview from '../components/ComicPreview.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Meta from "../components/meta.astro";
import { formatDate } from '../api/utils';

const imageImports = import.meta.glob('../images/**/*.{png,jpg,jpeg,gif,webp,JPG,JPEG}',{
  eager: true
});

const illustrations = (await getCollection("comics", ({ data }) => data.type === "illustrations"))
  .sort((a, b) => {
    const dateDifference = Date.parse(b.data.date.replace(/\s+/g, "-")) - Date.parse(a.data.date.replace(/\s+/g, "-"));
    return dateDifference || Number(b.data.id) - Number(a.data.id);
  });

---

<Meta />
<body>
  <Navigation />
  <br /><br />
  <ul class="content_preview_grid libertinus-sans-regular">
    {
      illustrations.map((entry) => {
      const imgPath = entry.data.ogImage;
      const normalized = imgPath.replace(/\\/g, "/");
      const key = `${normalized}`;

      const importedImage = imageImports[key];
      if(!importedImage){
        console.error("Image not in glob");
        return null; // Skip rendering this entry
      }
    return (
        <ComicPreview
          link={`/comics/${entry.slug}`}
          title={entry.data.title}
          imgTitle={importedImage.default}
          subtitle={entry.data.subtitle}
          lastUpdated={formatDate(entry.data.date)}
          pagecount={entry.data.pagecount}
        />
  );
})
    }
  </ul>
  <Footer />
</body>